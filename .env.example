# Copy to .env and set real values before `docker compose up`.
# The stack refuses to start if any of these is unset — that is deliberate.
# Generate each one separately, e.g.  openssl rand -base64 24

# Grafana admin login (observability stack)
GF_SECURITY_ADMIN_PASSWORD=

# MinIO object storage root credentials
MINIO_ROOT_PASSWORD=

# AWX (automation stack)
AWX_SECRET_KEY=
AWX_ADMIN_PASSWORD=
